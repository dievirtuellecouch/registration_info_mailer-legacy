{
    "name": "dvc/registration_info_mailer",
    "version": "5.7.0",
    "description": "Send a customized email if a new user registers, activates an account or changes account status.",
    "keywords": [
        "contao",
        "registration",
        "registration_info_mailer"
    ],
    "type": "contao-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Andreas Isaak",
            "email": "isaak@men-at-work.de",
            "homepage": "http://www.men-at-work.de",
            "role": "Developer"
        },
        {
            "name": "David Maack",
            "email": "maack@men-at-work.de",
            "homepage": "http://www.men-at-work.de",
            "role": "Developer"
        },
        {
            "name": "Leo Unglaub",
            "email": "leo@leo-unglaub.net",
            "homepage": "http://www.leo-unglaub.net",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/dievirtuellecouch/registration_info_mailer-legacy/issues",
        "source": "https://github.com/dievirtuellecouch/registration_info_mailer-legacy"
    },
    "require": {
        "php": "^8.3",
        "contao/core-bundle": "^5.7",
        "terminal42/notification_center": "^2.7",
        "doctrine/dbal": "^3.8 || ^4.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0",
        "menatwork/registration_info_mailer": "*"
    },
    "autoload": {
        "psr-4": {
            "MenAtWork\\RegistrationInfoMailerBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "MenAtWork\\RegistrationInfoMailerBundle\\ContaoManager\\Plugin"
    },
    "autoload-dev": {
        "psr-4": {
            "MenAtWork\\RegistrationInfoMailerBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
